{
  "expo": {
    "name": "Ordo Companion",
    "slug": "ordo-companion",
    "version": "1.7.0-beta.1",
    "orientation": "default",
    "scheme": "com.ordemparanormal.ordo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ordemparanormal.ordo",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.ordemparanormal.ordo",
      "versionCode": 13,
      "largeHeap": true,
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.556485656355-grsjjk5ol3keimcnn905f5vrd7lk0jos"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "androidNavigationBar": {
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Ordo Companion",
      "shortName": "Ordo Companion",
      "lang": "pt-BR",
      "scope": "/",
      "themeColor": "#0A0A0C",
      "backgroundColor": "#0A0A0C",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sharing",
      "@config-plugins/react-native-pdf",
      "@config-plugins/react-native-blob-util",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que $(PRODUCT_NAME) acesse o microfone para ditar comandos ao G.L.I.T.C.H.",
          "speechRecognitionPermission": "Permitir que $(PRODUCT_NAME) use o reconhecimento de voz para transcrever perguntas.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ffae326d-8143-4c02-9e02-11d4bc95a119"
      }
    }
  }
}
