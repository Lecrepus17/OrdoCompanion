{
  "expo": {
    "name": "Ordo Companion",
    "slug": "ordo-companion",
    "version": "1.0.1-beta.1",
    "orientation": "default",
    "scheme": "com.ordemparanormal.ordo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ordemparanormal.ordo",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.ordemparanormal.ordo",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "androidNavigationBar": {
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ffae326d-8143-4c02-9e02-11d4bc95a119"
      }
    }
  }
}
