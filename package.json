    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "pdfjs-dist": "^3.11.174",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
