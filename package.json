{
  "name": "guia-ordem-paranormal",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start-clean": "npx expo start -c",
    "start-ngrok": " npx expo start --tunnel ngrok",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "extract": "python scripts/extract_all.py",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:db": "python scripts/test_database_integrity.py",
    "test:all": "npm run typecheck && npm run test && npm run test:db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
