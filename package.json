{
  "name": "ordo-companion",
  "version": "1.5.0-beta.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start-clean": "npx expo start -c",
    "start-ngrok": " npx expo start --tunnel ngrok",
    "start-clean-ngrok": " npx expo start -c --tunnel ngrok",
    "android": "expo run:android",
    "android:emu": "scripts\\iniciar_emulador_e_app.bat",
    "android:emu:ps": "powershell -ExecutionPolicy Bypass -File scripts/iniciar_emulador_e_app.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "extract": "python scripts/extract_all.py",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:unit": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:front": "tsx --test tests/*.test.tsx",
    "test:rules": "tsx --test tests/progression.test.ts tests/createAgentModal.test.tsx tests/levelUpModal.test.tsx",
    "test:sync": "tsx --test tests/smartMerge.test.ts tests/googleDriveService.test.ts tests/repository.test.ts tests/campaignRepository.test.ts",
    "test:db": "python scripts/test_database_integrity.py",
    "test:all": "npm run typecheck && npm run test && npm run test:db",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/create_release.js",
    "build:apk": "node scripts/build_and_upload_apk.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "pdfjs-dist": "^3.11.174",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-blob-util": "^1.0.0",
    "react-native-pdf": "^7.0.5",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@config-plugins/react-native-blob-util": "^14.0.2",
    "@config-plugins/react-native-pdf": "^14.0.2",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "license": "GPL-3.0-or-later",
  "private": true
}
