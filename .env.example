# Google OAuth Web Client ID (Navegador Web / Localhost)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=seu-client-id-web.apps.googleusercontent.com

# Google OAuth Android / Mobile Client ID (Aplicativo APK)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=seu-client-id-android.apps.googleusercontent.com

# Fallback geral
EXPO_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Chave de API Padrão para IA (Google Gemini - Free Tier)
# Opcional: Chave padrão do sistema para alimentar o G.L.I.T.C.H. para todos os usuários
# Quem quiser usar chave própria pode preencher diretamente nas configurações do app.
EXPO_PUBLIC_DEFAULT_GEMINI_API_KEY=sua-chave-gemini-aqui

# Chave padrão opcional do Groq (https://console.groq.com/keys) para o G.L.I.T.C.H.
EXPO_PUBLIC_DEFAULT_GROQ_API_KEY=gsk_sua-chave-groq-aqui

# Supabase da Mesa Virtual (apenas Realtime). Use SOMENTE a anon/publishable key, nunca a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sua-chave-aqui

# Central de Suporte & Relato de Erros (Opcional)
# Cole a URL de um Webhook do seu servidor do Discord para receber relatos enviados dentro do app em tempo real:
EXPO_PUBLIC_SUPPORT_DISCORD_WEBHOOK_URL=
# Endpoint HTTP alternativo (ex: Formspree / Supabase / API própria):
EXPO_PUBLIC_SUPPORT_ENDPOINT_URL=
# Dados públicos de contato direto exibidos na aba de Suporte:
EXPO_PUBLIC_SUPPORT_EMAIL=pedro.eduardo1777@gmail.com
EXPO_PUBLIC_SUPPORT_DISCORD_INVITE=https://discord.gg/seu-convite
EXPO_PUBLIC_SUPPORT_DISCORD_HANDLE=lecrepus17

# Senha Mestre de Acesso ao Acervo Oficial (Personalizável)
# Senha padrão secreta definida pelo Mestre para liberar os livros e compêndio
EXPO_PUBLIC_MASTER_PASSWORD=SUASENHA

# Pasta Compartilhada do Google Drive contendo os PDFs oficiais
# Link público ("Qualquer pessoa com o link pode visualizar") da pasta do Google Drive do Mestre
EXPO_PUBLIC_GDRIVE_BOOKS_FOLDER_URL=https://drive.google.com/drive/folders/seu-id-da-pasta
